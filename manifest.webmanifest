{
  "id": "/anime-partner/",
  "name": "Anime Partner",
  "short_name": "Anime Partner",
  "description": "A private, offline-capable anime companion: track every episode, plan a watch schedule, get recommendations that explain themselves, learn Japanese, read free novels and play games. No account, no ads. Developed by Shin.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#07080f",
  "theme_color": "#0d0f1a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["entertainment", "education", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "./screenshots/home.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Your day: streak, level, coins and today's small things" },
    { "src": "./screenshots/tracker.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Tracker: every show, season and episode with watch time" },
    { "src": "./screenshots/plan.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Plan a finish date and the app schedules your episodes" },
    { "src": "./screenshots/discover.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Recommendations with a real reason behind every pick" },
    { "src": "./screenshots/games.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Games online and offline, plus free Japanese lessons" }
  ],
  "shortcuts": [
    {
      "name": "Tracker",
      "short_name": "Tracker",
      "description": "Jump straight to your library and episode counts",
      "url": "./index.html#/tracker",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Discover",
      "short_name": "Discover",
      "description": "See what to watch next and why",
      "url": "./index.html#/discover",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Learn Japanese",
      "short_name": "Learn",
      "description": "Kana, vocabulary, grammar and speaking practice",
      "url": "./index.html#/learn/kana",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
